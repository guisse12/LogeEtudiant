{
  "expo": {
    "name": "LogeEtudiant",
    "slug": "LogeEtudiant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LogeEtudiant a besoin de votre position pour afficher les logements étudiants autour de vous.",
        "NSPhotoLibraryUsageDescription": "LogeEtudiant a besoin d'accéder à vos photos pour vous permettre de publier des logements.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tel",
          "mailto",
          "comgooglemaps",
          "iosamap"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.capico.logeetudiant",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser LogeEtudiant à utiliser votre position pour afficher les logements autour de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser LogeEtudiant à accéder à vos photos pour ajouter des images de logement."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a2e4b902-d4ed-4b0c-8cf9-5a1bd73e68b6"
      }
    }
  }
}